# Cineora runtime configuration — variable NAMES ONLY.
#
# Copy to `.env.local` and fill in your own values. `.env.local` is gitignored and
# must stay that way: this file exists so nobody ever needs to commit a real one.
#
# Nothing here is required to browse, search or play. Cineora deploys with zero
# variables: metadata comes from a key-free public addon and playback from a
# documented embed. Accounts are the part that needs configuration, and if the
# account variables are absent the account endpoints answer "not configured" and the
# UI hides sign-in rather than the site failing to build.
#
# Only variables prefixed NEXT_PUBLIC_ reach the browser. Never give a secret that
# prefix — there is no such thing as a private NEXT_PUBLIC_ value.

# ─── Public, and safe to expose ──────────────────────────────────────────────────

# Site origin, used for canonical URLs, Open Graph tags and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base origin of the Nxsha embed provider (documented at https://nxsha.space/embed).
# Also feeds the Content-Security-Policy `frame-src` allowlist in next.config.ts.
NEXT_PUBLIC_NXSHA_ORIGIN=https://nxsha.space

# ─── Metadata ────────────────────────────────────────────────────────────────────

# Base origin of the key-free Cinemeta metadata addon. Change only to point at your
# own mirror — see docs/INTEGRATIONS.md.
CINEORA_CINEMETA_ORIGIN=https://v3-cinemeta.strem.io

# ─── Accounts: required to enable sign-in ────────────────────────────────────────

# Signs session cookies, CSRF tokens, verification/reset tokens and download grants.
# At least 32 characters, high entropy, never committed and never shared between
# environments. Generate one with:  openssl rand -base64 48  — or, on any OS with Node:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Rotating it invalidates every session, pending email token and download link.
SESSION_SECRET=

# ─── Email (server-side SMTP only) ───────────────────────────────────────────────
#
# With all three of HOST/USER/PASSWORD set, mail is sent. With any of them missing,
# mail is written to a local outbox under CINEORA_DATA_DIR instead — a development
# convenience, never a production fallback. For Gmail, SMTP_PASSWORD must be a
# 16-character App Password, not the account password, and 2-Step Verification has to
# be on. These values are read server-side only; they never enter a client bundle.

SMTP_HOST=
SMTP_PORT=587
# Leave unset: it is derived from the port (465 = implicit TLS, 587 = STARTTLS).
# Set to true/false only for a relay that disagrees.
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=

# From: address on outgoing mail. Defaults to "Cineora <SMTP_USER>".
MAIL_FROM=
# Reply-to / support address shown in email footers. Defaults to SMTP_USER.
SUPPORT_EMAIL=

# ─── Storage ─────────────────────────────────────────────────────────────────────

# blobs | fs | memory. Defaults to blobs on Netlify, fs in local development, and
# memory otherwise. `memory` loses every account on restart, so production refuses to
# report accounts as enabled while it is in use.
CINEORA_DATA_DRIVER=

# Directory for the `fs` driver and the development outbox. Defaults to .data
CINEORA_DATA_DIR=

# Netlify Blobs store name for the `blobs` driver. Defaults to cineora-accounts
CINEORA_BLOBS_STORE=

# ─── Session lifetimes, in seconds ───────────────────────────────────────────────

# Ordinary sign-in. Defaults to 604800 (7 days).
CINEORA_SESSION_TTL=
# "Keep me signed in". Defaults to 2592000 (30 days).
CINEORA_REMEMBER_TTL=

# ─── Authorized downloads ────────────────────────────────────────────────────────
#
# JSON describing the files THIS deployment is licensed to distribute. Absent means
# no downloads are offered, which is the correct default: Cineora hosts no video and
# holds no rights to what the metadata and playback providers serve. Every entry must
# name the licence that permits distribution. Asset URLs belong here rather than in
# the repository because a signed storage URL is a credential.
#
# Schema and a worked example: docs/DOWNLOADS.md
CINEORA_DOWNLOAD_CATALOG=
