# Cineora runtime configuration
#
# No API keys are required. Cineora uses the public, key-free Cinemeta metadata
# service and the documented Nxsha embed API.
#
# Optional overrides (all have working defaults):

# Public site origin, used for canonical URLs, Open Graph tags and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base origin of the Nxsha embed provider (documented at https://nxsha.space/embed).
NEXT_PUBLIC_NXSHA_ORIGIN=https://nxsha.space

# Base origin of the key-free Cinemeta metadata addon.
CINEORA_CINEMETA_ORIGIN=https://v3-cinemeta.strem.io
